+"""FizzBuzz: 1 から n までの文字列のリストを返す。"""
+
+from __future__ import annotations
+
+
+def fizzbuzz(n: int) -> list[str]:
+    """1 から n までの各数について、以下の文字列を順に並べたリストを返す。
+
+    - 3 と 5 の両方の倍数: "FizzBuzz"
+    - 3 の倍数:          "Fizz"
+    - 5 の倍数:          "Buzz"
+    - それ以外:            数字そのものの文字列
+
+    n が 1 未満の場合は空のリストを返す。
+    """
+    result: list[str] = []
+    for i in range(1, n + 1):
+        if i % 15 == 0:
+            result.append("FizzBuzz")
+        elif i % 3 == 0:
+            result.append("Fizz")
+        elif i % 5 == 0:
+            result.append("Buzz")
+        else:
+            result.append(str(i))
+    return result
+
+
+if __name__ == "__main__":
+    lines = fizzbuzz(15)
+    if lines:
+        print("\n".join(lines))
