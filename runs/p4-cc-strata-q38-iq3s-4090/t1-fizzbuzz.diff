+import typing
+
+import pytest
+
+from fizzbuzz import fizzbuzz
+
+
+def test_signature():
+    hints = typing.get_type_hints(fizzbuzz)
+    assert hints == {"n": int, "return": list[str]}
+
+
+def test_returns_list_of_str():
+    result = fizzbuzz(15)
+    assert isinstance(result, list)
+    assert all(isinstance(item, str) for item in result)
+
+
+def test_first_fifteen():
+    assert fizzbuzz(15) == [
+        "1", "2", "Fizz", "4", "Buzz",
+        "Fizz", "7", "8", "Fizz", "Buzz",
+        "11", "Fizz", "13", "14", "FizzBuzz",
+    ]
+
+
+def test_length_matches_n():
+    for n in (0, 1, 5, 15, 100):
+        assert len(fizzbuzz(n)) == max(n, 0)
+
+
+def expected_positions(n, predicate):
+    return set(i for i in range(1, n + 1) if predicate(i))
+
+
+def actual_positions(result, label):
+    return set(i for i, value in enumerate(result, start=1) if value == label)
+
+
+def test_multiples_of_three_are_fizz():
+    result = fizzbuzz(30)
+    expected = expected_positions(30, lambda i: i % 3 == 0 and i % 5 != 0)
+    assert actual_positions(result, "Fizz") == expected
+
+
+def test_multiples_of_five_are_buzz():
+    result = fizzbuzz(30)
+    expected = expected_positions(30, lambda i: i % 5 == 0 and i % 3 != 0)
+    assert actual_positions(result, "Buzz") == expected
+
+
+def test_multiples_of_fifteen_are_fizzbuzz():
+    result = fizzbuzz(45)
+    assert actual_positions(result, "FizzBuzz") == expected_positions(45, lambda i: i % 15 == 0)
+
+
+def test_others_are_number_strings():
+    result = fizzbuzz(10)
+    plain = [i for i in range(1, 11) if i % 3 and i % 5]
+    assert [result[i - 1] for i in plain] == [str(i) for i in plain]
+
+
+@pytest.mark.parametrize(
+    ("n", "expected"),
+    [
+        (0, []),
+        (1, ["1"]),
+        (2, ["1", "2"]),
+        (3, ["1", "2", "Fizz"]),
+        (5, ["1", "2", "Fizz", "4", "Buzz"]),
+        (-3, []),
+    ],
+)
+def test_small_values(n, expected):
+    assert fizzbuzz(n) == expected
+
+
+def test_counts_up_to_100():
+    result = fizzbuzz(100)
+    # 3 の倍数は 33 個、5 の倍数は 20 個、15 の倍数は 6 個
+    assert result.count("FizzBuzz") == 6
+    assert result.count("Fizz") == 33 - 6
+    assert result.count("Buzz") == 20 - 6
+    assert len(result) == 6 + 27 + 14 + (100 - 33 - 20 + 6)
+    assert result[97] == "98"  # 3 でも 5 でも割り切れない → 数字の文字列
+    assert result[98] == "Fizz"  # 99
+    assert result[99] == "Buzz"  # 100
