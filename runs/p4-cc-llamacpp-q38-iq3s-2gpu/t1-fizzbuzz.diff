+"""FizzBuzz の実装。"""
+
+
+def fizzbuzz(n: int) -> list[str]:
+    """1 から n までの FizzBuzz 表現を順に返す。
+
+    3 の倍数は "Fizz"、5 の倍数は "Buzz"、両方の倍数は "FizzBuzz"、
+    それ以外は数字の文字列。
+    """
+    result: list[str] = []
+    for i in range(1, n + 1):
+        if i % 15 == 0:
+            result.append("FizzBuzz")
+        elif i % 3 == 0:
+            result.append("Fizz")
+        elif i % 5 == 0:
+            result.append("Buzz")
+        else:
+            result.append(str(i))
+    return result
