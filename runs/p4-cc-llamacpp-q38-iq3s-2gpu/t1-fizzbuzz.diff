+import pytest
+
+from fizzbuzz import fizzbuzz
+
+
+def test_returns_list_of_str():
+    result = fizzbuzz(1)
+    assert isinstance(result, list)
+    assert all(isinstance(item, str) for item in result)
+
+
+def test_n_less_than_1_returns_empty():
+    assert fizzbuzz(0) == []
+    assert fizzbuzz(-5) == []
+
+
+def test_first_fifteen():
+    assert fizzbuzz(15) == [
+        "1",
+        "2",
+        "Fizz",
+        "4",
+        "Buzz",
+        "Fizz",
+        "7",
+        "8",
+        "Fizz",
+        "Buzz",
+        "11",
+        "Fizz",
+        "13",
+        "14",
+        "FizzBuzz",
+    ]
+
+
+@pytest.mark.parametrize(
+    ("n", "expected"),
+    [
+        (1, ["1"]),
+        (2, ["1", "2"]),
+        (3, ["1", "2", "Fizz"]),
+        (5, ["1", "2", "Fizz", "4", "Buzz"]),
+    ],
+)
+def test_small_values(n, expected):
+    assert fizzbuzz(n) == expected
+
+
+@pytest.mark.parametrize(
+    ("index", "expected"),
+    [
+        (3, "Fizz"),
+        (5, "Buzz"),
+        (6, "Fizz"),
+        (9, "Fizz"),
+        (10, "Buzz"),
+        (15, "FizzBuzz"),
+        (30, "FizzBuzz"),
+        (45, "FizzBuzz"),
+    ],
+)
+def test_multiples(index, expected):
+    assert fizzbuzz(index)[index - 1] == expected
+
+
+def test_length_equals_n():
+    for n in (0, 1, 7, 50, 100):
+        assert len(fizzbuzz(n)) == n
+
+
+def test_fizzbuzz_precedence_over_fizz_and_buzz():
+    result = fizzbuzz(30)
+    for i, value in enumerate(result, start=1):
+        if i % 3 == 0 and i % 5 == 0:
+            assert value == "FizzBuzz"
+        elif i % 3 == 0:
+            assert value == "Fizz"
+        elif i % 5 == 0:
+            assert value == "Buzz"
+        else:
+            assert value == str(i)
