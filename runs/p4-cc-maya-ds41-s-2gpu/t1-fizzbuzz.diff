+import pytest
+
+from fizzbuzz import fizzbuzz
+
+
+def test_returns_list_of_length_n():
+    assert len(fizzbuzz(5)) == 5
+
+
+def test_first_fifteen_terms():
+    assert fizzbuzz(15) == [
+        "1", "2", "Fizz", "4", "Buzz",
+        "Fizz", "7", "8", "Fizz", "Buzz",
+        "11", "Fizz", "13", "14", "FizzBuzz",
+    ]
+
+
+def test_multiples_of_three():
+    assert fizzbuzz(9)[2] == "Fizz"
+    assert fizzbuzz(9)[5] == "Fizz"
+    assert fizzbuzz(9)[8] == "Fizz"
+
+
+def test_multiples_of_five():
+    assert fizzbuzz(10)[4] == "Buzz"
+    assert fizzbuzz(10)[9] == "Buzz"
+
+
+def test_multiples_of_both():
+    assert fizzbuzz(30)[14] == "FizzBuzz"
+    assert fizzbuzz(30)[29] == "FizzBuzz"
+
+
+def test_plain_numbers():
+    assert fizzbuzz(7)[0] == "1"
+    assert fizzbuzz(7)[6] == "7"
+
+
+@pytest.mark.parametrize("n", [1, 2, 4, 7, 11, 13, 14])
+def test_non_multiples_are_strings(n):
+    result = fizzbuzz(n)
+    assert result[n - 1] == str(n)
+
+
+def test_zero_returns_empty_list():
+    assert fizzbuzz(0) == []
+
+
+def test_negative_raises():
+    with pytest.raises(ValueError):
+        fizzbuzz(-1)
+
+
+@pytest.mark.parametrize("n", [3, 5, 15, 100])
+def test_every_term_is_str(n):
+    assert all(isinstance(x, str) for x in fizzbuzz(n))
