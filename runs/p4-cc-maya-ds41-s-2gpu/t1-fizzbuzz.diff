+"""FizzBuzz の実装。"""
+
+from typing import List
+
+
+def fizzbuzz(n: int) -> List[str]:
+    """1 から n までの FizzBuzz の結果をリストで返す。
+
+    3 の倍数は "Fizz"、5 の倍数は "Buzz"、15 の倍数は "FizzBuzz"、
+    それ以外は数字を文字列にしたものを返す。
+
+    Args:
+        n: 生成する項数（0 以上の整数）。
+
+    Returns:
+        長さ n のリスト。n が 0 の場合は空リスト。
+
+    Raises:
+        ValueError: n が負の場合。
+    """
+    if n < 0:
+        raise ValueError("n must be non-negative")
+
+    result: List[str] = []
+    for i in range(1, n + 1):
+        if i % 15 == 0:
+            result.append("FizzBuzz")
+        elif i % 3 == 0:
+            result.append("Fizz")
+        elif i % 5 == 0:
+            result.append("Buzz")
+        else:
+            result.append(str(i))
+    return result
